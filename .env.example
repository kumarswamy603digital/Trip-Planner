# ── NammaYatri AI · narration provider ───────────────────────────────
# The app is 100% functional with NO key (built-in template narrator).
# Add ONE key below, copy this file to `.env`, and AI narration turns on
# automatically. Never commit `.env`.

# Which provider to use: openai | claude | gemini
NARRATE_PROVIDER=openai

# OpenAI  (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
